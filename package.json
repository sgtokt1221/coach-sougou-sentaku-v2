{
  "name": "coach-sougou-sentaku",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "emu": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:start --project demo-coach --config firebase.emu.json --only auth,firestore,storage --import ./.emulator-data --export-on-exit ./.emulator-data",
    "seed:emu": "NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-coach FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9599 FIRESTORE_EMULATOR_HOST=127.0.0.1:8581 tsx scripts/seed-emulator.ts",
    "dev:emu": "NEXT_PUBLIC_FIREBASE_EMULATOR=1 NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-coach NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-coach.appspot.com NEXT_PUBLIC_FIREBASE_EMULATOR_AUTH_PORT=9599 NEXT_PUBLIC_FIREBASE_EMULATOR_FIRESTORE_PORT=8581 NEXT_PUBLIC_FIREBASE_EMULATOR_STORAGE_PORT=9699 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9599 FIRESTORE_EMULATOR_HOST=127.0.0.1:8581 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9699 next dev",
    "dev:https": "next dev --experimental-https --experimental-https-cert certs/cert.pem --experimental-https-key certs/key.pem",
    "build": "rm -rf .next && npm run validate:data && NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "check-env": "tsx scripts/check-env.ts",
    "validate:data": "tsx scripts/validate-university-data.ts && tsx scripts/validate-logic-drills.ts && tsx scripts/validate-logical-tour.ts && tsx scripts/validate-recurring-class.ts && tsx scripts/validate-report-materials.ts && tsx scripts/validate-sentence-drills.ts && tsx scripts/validate-essay-lectures.ts && tsx scripts/verify-report-question.ts",
    "seed:universities": "tsx scripts/seed-universities.ts",
    "seed:superadmin": "tsx scripts/seed-superadmin.ts",
    "consolidate:weaknesses": "tsx scripts/consolidate-weaknesses-taxonomy.ts",
    "verify:choco": "tsx scripts/verify-choco-logic.ts",
    "validate:choco": "tsx scripts/validate-choco-passages.ts",
    "verify:ai-prompts": "tsx scripts/verify-ai-prompt-safety.ts"
  },
