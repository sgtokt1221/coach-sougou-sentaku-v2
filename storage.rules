rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Essay images: users can upload/read their own, admins can read all
    match /essays/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024  // 10MB limit
        && request.resource.contentType.matches('image/.*');
    }

    // Essay OCR images: 本人と同一orgのadminのみ read。書き込みはサーバ(admin SDK)のみ
    match /essayOcr/{orgId}/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Audio recordings: users can upload/read their own, admins can read all
    match /audio/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024  // 50MB limit
        && request.resource.contentType.matches('audio/.*');
    }

    // Documents (application docs): users can upload/read their own
    match /documents/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }

    // User avatars: 公開読み取り (生徒/admin が一覧で表示するため)、書き込みは本人のみ
    match /users/{userId}/avatar/{filename} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Admin check helper
    function isAdmin() {
      return request.auth.token.role in ['admin', 'teacher', 'superadmin'];
    }
  }
}
