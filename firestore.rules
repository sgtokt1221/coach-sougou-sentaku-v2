rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ユーザー: 自分のデータ + 担当 admin + 同じ塾の admin + superadmin
    match /users/{userId} {
      allow read: if request.auth != null && canManageUser(userId);
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isManagerOf(userId)
      );

      // 弱点サブコレクション
      match /weaknesses/{weaknessId} {
        allow read: if request.auth != null && canManageUser(userId);
        allow write: if request.auth != null && (
          request.auth.uid == userId || isSuperAdmin() || isManagerOf(userId)
        );
      }

      // 小論文サブコレクション
      match /essays/{essayId} {
        allow read: if request.auth != null && canManageUser(userId);
        allow write: if request.auth != null && (
          request.auth.uid == userId || isSuperAdmin() || isManagerOf(userId)
        );
      }

      // 面接サブコレクション
      match /interviews/{interviewId} {
        allow read: if request.auth != null && canManageUser(userId);
        allow write: if request.auth != null && (
          request.auth.uid == userId || isSuperAdmin() || isManagerOf(userId)
        );
      }

      // 出願書類
      match /documents/{docId} {
        allow read: if request.auth != null && canManageUser(userId);
        allow write: if request.auth != null && (
          request.auth.uid == userId || isSuperAdmin() || isManagerOf(userId)
        );
      }

      // 活動実績
      match /activities/{activityId} {
        allow read: if request.auth != null && canManageUser(userId);
        allow write: if request.auth != null && (
          request.auth.uid == userId || isSuperAdmin() || isManagerOf(userId)
        );
      }

      // スキルチェック履歴
      match /skillChecks/{resultId} {
        allow read: if request.auth != null && canManageUser(userId);
        allow write: if request.auth != null && (
          request.auth.uid == userId || isSuperAdmin() || isManagerOf(userId)
        );
      }

      // 面接スキルチェック履歴
      match /interviewSkillChecks/{resultId} {
        allow read: if request.auth != null && canManageUser(userId);
        allow write: if request.auth != null && (
          request.auth.uid == userId || isSuperAdmin() || isManagerOf(userId)
        );
      }

      // フィードバック
      match /feedback/{feedbackId} {
        allow read: if request.auth != null && canManageUser(userId);
        allow create: if request.auth != null && (
          isSuperAdmin() || isManagerOf(userId) || isSameOrg(userId)
        );
        allow update: if request.auth != null && request.auth.uid == userId;
      }

      // 生徒↔講師スレッド (管理者スレッド feedback とは別物)。
      // read: 生徒本人/担当管理者/同org/superadmin(=監視) + 担当講師。
      // write は基本 server(Admin SDK) 経由だが、担当講師の購読・自己既読のため許可。
      match /teacherFeedback/{feedbackId} {
        // 生徒本人/担当管理者/同org/superadmin は全件。講師は自分の teacherId スレッドのみ
        // (複数講師が同サブコレクションを共有しても講師間で読めないよう隔離)
        allow read: if request.auth != null && (
          canManageUser(userId) ||
          (isAssignedTeacherOf(userId) && resource.data.teacherId == request.auth.uid)
        );
        allow create: if request.auth != null && (
          isSuperAdmin() || request.auth.uid == userId || isAssignedTeacherOf(userId)
        );
        allow update: if request.auth != null && (
          request.auth.uid == userId || isAssignedTeacherOf(userId)
        );
      }
    }

    // 大学データ: 全員読み取り可、管理者のみ書き込み
    match /universities/{universityId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 過去問サンプル sourceText キャッシュ (動的生成)
    // 全認証ユーザー read 可、書き込みは API ルート (Admin SDK) 経由のみ
    match /pastQuestionSourceTexts/{questionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 面接コンテンツ・バンク。読み書きは superadmin のみ (実際の CRUD は API/Admin SDK 経由)
    match /interviewContent/{itemId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // 面接セッション（トップレベル）: 参加者 + 担当 admin / 同塾 admin / superadmin
    match /interviews/{interviewId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin() ||
        isManagerOf(resource.data.userId) ||
        isSameOrg(resource.data.userId)
      );
      allow write: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        isSuperAdmin() ||
        isManagerOf(request.resource.data.userId)
      );
    }

    // 面談セッション: 参加者 + admin/superadmin のみ
    match /sessions/{sessionId} {
      allow read: if request.auth != null && (
        resource.data.teacherId == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        isSuperAdmin()
      );
      allow write: if request.auth != null && (
        resource.data.teacherId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if request.auth != null && isAdmin();
    }

    // 合格者データ（匿名化済み）
    match /passedStudentData/{dataId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 分析データ
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 招待コード: Admin SDKのみアクセス（クライアント全拒否）
    match /invitations/{code} {
      allow read, write: if false;
    }

    // 管理者カスタムカレンダーイベント: Admin SDK 経由のみ
    match /adminEvents/{eventId} {
      allow read, write: if false;
    }

    // 小論文AIコーチ対話スレッド: Admin SDK 経由のみ
    match /users/{userId}/essayCoachThreads/{threadId} {
      allow read, write: if false;
    }

    // organizations: superadmin のみ書き込み、 メンバーは read 可
    match /organizations/{orgId} {
      allow read: if request.auth != null && (
        isSuperAdmin() || request.auth.uid in resource.data.memberAdminUids
      );
      allow write: if isSuperAdmin();
    }

    // スーパー管理者チェック関数
    function isSuperAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // 管理者チェック関数（admin, teacher, superadmin）
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'teacher', 'superadmin'];
    }

    // 担当admin/teacherチェック: 対象生徒のmanagedByが自分のuidか確認
    function isManagerOf(userId) {
      return isAdmin() &&
        get(/databases/$(database)/documents/users/$(userId)).data.managedBy == request.auth.uid;
    }

    // 担当講師チェック: 対象生徒の assignedTeacherIds に自分(講師)が含まれるか確認
    // (後方互換で旧 assignedTeacherId 単一フィールドも許可)
    function isAssignedTeacherOf(userId) {
      return isAdmin() &&
        (
          (get(/databases/$(database)/documents/users/$(userId)).data.assignedTeacherIds != null &&
            request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.assignedTeacherIds)
          ||
          get(/databases/$(database)/documents/users/$(userId)).data.assignedTeacherId == request.auth.uid
        );
    }

    // 同じ塾 (organization) のメンバーか確認 (= 親 admin / 子 admin 関係)
    function isSameOrg(userId) {
      return isAdmin() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId ==
        get(/databases/$(database)/documents/users/$(userId)).data.organizationId;
    }

    // 「対象ユーザーを管理する権限」 を一元判定:
    // - 自分自身 / superadmin / 担当 admin / 同じ塾の admin のいずれか
    function canManageUser(userId) {
      return request.auth.uid == userId ||
        isSuperAdmin() ||
        isManagerOf(userId) ||
        isSameOrg(userId);
    }
  }
}
