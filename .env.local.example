# ==================================================
# Firebase Client SDK (Required)
# Firebase Console > Project Settings > General > Web App
# ==================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ==================================================
# Firebase Admin SDK (Required for API routes)
# Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# ==================================================
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ==================================================
# Anthropic Claude API (Required for AI features)
# https://console.anthropic.com/
# Used by: essay/review, essay/upload, interview/*, documents/review,
#          activities/interview, activities/optimize, summary/generate
# ==================================================
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# ==================================================
# OpenAI API (Required for voice interview)
# https://platform.openai.com/
# Used by: interview/tts (TTS), interview/voice-message (Whisper), transcribe
# ==================================================
OPENAI_API_KEY=sk-xxxxx

# ==================================================
# Gemini API (Optional - Gemini Live を音声面接プロバイダに使う場合)
# https://aistudio.google.com/apikey
# Used by: interview/gemini-live-session (ephemeral token 発行)
# GEMINI_LIVE_MODEL は未指定なら native audio プレビュー版を使用
# クライアントのプロバイダ切替: NEXT_PUBLIC_INTERVIEW_VOICE_PROVIDER=gemini
# ==================================================
GEMINI_API_KEY=AIza-xxxxx
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# NEXT_PUBLIC_INTERVIEW_VOICE_PROVIDER=openai

# ==================================================
# Google Programmable Search Engine (Optional - enables in-panel browsing)
# https://programmablesearchengine.google.com/controlpanel/create
# 「検索エンジン ID (cx)」をコピーして設定。未設定時は別タブ起動方式で動作。
# クライアントに露出する非機密値 (NEXT_PUBLIC_)
# ==================================================
# NEXT_PUBLIC_GOOGLE_PSE_CX=

# ==================================================
# BigQuery (Optional - for passed student data analytics)
# ==================================================
# GOOGLE_CLOUD_PROJECT_ID=
# BIGQUERY_DATASET=coach_analytics

# ==================================================
# Stripe (Required for billing)
# https://dashboard.stripe.com/
# ==================================================
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRO_PRICE_ID=price_xxxxx
